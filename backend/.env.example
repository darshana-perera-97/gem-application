PORT=1324
MONGODB_URI=mongodb://127.0.0.1:27017/gem
# Optional: absolute path to the CRA build folder. Default: ../frontend/build
# FRONTEND_BUILD_PATH=
# Set to false to keep API-only even if a build folder exists.
# SERVE_FRONTEND=true
FIREBASE_PROJECT_ID=gen-lang-client-0021275657

# Google Cloud OAuth client (APIs & Services > Credentials > OAuth client ID > Web).
# Authorized redirect URI must be exactly GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:1324/api/auth/google/callback

# Used to sign the login cookie. Replace with a long random string.
AUTH_SECRET=replace-with-a-long-random-string

# Platform admin login for /admin (stored only in this file, not in the database).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-going-live

# SMTP account used to email sign-in codes.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
